#!/usr/bin/env node
// Loads every page of the built site (_site) in headless Chrome and fails on
// accessibility and layout problems that html-proofer can't see:
//
//   - axe-core WCAG 2.1 AA violations, in both light and dark theme
//   - horizontal scrolling at phone width (375px)
//   - JavaScript errors and failed requests for the site's own files
//
// Third-party requests (YouTube, PayPal, Google Photos) are blocked so the
// check is fast and doesn't depend on other sites.
//
// Each page is loaded once: light-mode WCAG is evaluated, dark theme is applied
// in-place to re-evaluate contrast, and the viewport is set to phone width to
// verify sideways scroll.
//
// Usage: script/check-pages [--report-only]
// Set CHROME_PATH if Chrome isn't at standard paths.

"use strict";

const fs = require("fs");
const http = require("http");
const os = require("os");
const path = require("path");
const puppeteer = require("puppeteer-core");

const SITE = path.join(__dirname, "..", "_site");
const REPORT_ONLY = process.argv.includes("--report-only");
const AXE = fs.readFileSync(require.resolve("axe-core/axe.min.js"), "utf8");
const WORKERS = process.env.CI ? 2 : Math.min(os.cpus().length || 4, 6);

function findChrome() {
  if (process.env.CHROME_PATH) return process.env.CHROME_PATH;
  const candidates = [
    "/usr/bin/google-chrome",
    "/usr/bin/chromium-browser",
    "/usr/bin/chromium",
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  ];
  return candidates.find((p) => fs.existsSync(p)) || "/usr/bin/google-chrome";
}
const CHROME = findChrome();

// Pages that aren't real site pages.
const SKIP = new Set(["/google39b1e89a4bce5086.html"]);

// Errors caused by blocking third-party scripts rather than by the site.
const IGNORED_ERRORS = [/\bpaypal is not defined\b/, /\bcartPaypal is not defined\b/];

const DESKTOP_VIEWPORT = { width: 1280, height: 900 };
const PHONE_VIEWPORT = { width: 375, height: 812, isMobile: true, hasTouch: true, deviceScaleFactor: 2 };

const TYPES = {
  ".html": "text/html; charset=utf-8",
  ".css": "text/css",
  ".js": "text/javascript",
  ".json": "application/json",
  ".svg": "image/svg+xml",
  ".png": "image/png",
  ".jpg": "image/jpeg",
  ".jpeg": "image/jpeg",
  ".gif": "image/gif",
  ".webp": "image/webp",
  ".ico": "image/x-icon",
  ".pdf": "application/pdf",
};

function listPages(dir, prefix = "") {
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
    const url = `${prefix}/${entry.name}`;
    if (entry.isDirectory()) return listPages(path.join(dir, entry.name), url);
    return entry.name.endsWith(".html") && !SKIP.has(url) ? [url] : [];
  });
}

function serve() {
  const server = http.createServer((req, res) => {
    let file = path.join(SITE, decodeURIComponent(new URL(req.url, "http://x").pathname));
    if (!file.startsWith(SITE)) file = SITE;
    if (fs.existsSync(file) && fs.statSync(file).isDirectory()) file = path.join(file, "index.html");
    fs.readFile(file, (err, data) => {
      if (err) {
        res.writeHead(404);
        res.end();
        return;
      }
      res.writeHead(200, { "Content-Type": TYPES[path.extname(file).toLowerCase()] || "application/octet-stream" });
      res.end(data);
    });
  });
  return new Promise((resolve) => server.listen(0, "127.0.0.1", () => resolve(server)));
}

async function checkPage(context, origin, url) {
  const problems = [];
  const page = await context.newPage();
  await page.setViewport(DESKTOP_VIEWPORT);
  await page.evaluateOnNewDocument(() => {
    try {
      localStorage.setItem("paara-theme", "light");
    } catch (e) {
      // Ignore; the page falls back to light.
    }
  });
  await page.setRequestInterception(true);
  page.on("request", (req) => {
    const local = req.url().startsWith(origin) || req.url().startsWith("data:");
    local ? req.continue() : req.abort("blockedbyclient");
  });
  page.on("pageerror", (err) => {
    const message = String(err.message || err);
    if (!IGNORED_ERRORS.some((re) => re.test(message))) problems.push(`JavaScript error: ${message}`);
  });
  page.on("response", (res) => {
    if (res.url().startsWith(origin) && res.status() >= 400) problems.push(`${res.status()} for ${res.url().slice(origin.length)}`);
  });

  await page.goto(origin + url, { waitUntil: "load", timeout: 60000 });

  // 1. Accessibility in light theme
  await page.evaluate(AXE);
  const lightViolations = await page.evaluate(async () => {
    const result = await window.axe.run(document, {
      runOnly: { type: "tag", values: ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"] },
      resultTypes: ["violations"],
    });
    return result.violations.map((v) => ({ id: v.id, help: v.help, targets: v.nodes.map((n) => n.target.join(" ")) }));
  });
  for (const v of lightViolations) {
    const more = v.targets.length > 3 ? ` (+${v.targets.length - 3} more)` : "";
    problems.push(`(light): ${v.id}: ${v.help} [${v.targets.slice(0, 3).join(", ")}${more}]`);
  }

  // 2. Accessibility in dark theme
  await page.evaluate(() => {
    const style = document.createElement("style");
    style.id = "disable-transitions";
    style.textContent = "*, *::before, *::after { transition: none !important; }";
    document.head.appendChild(style);
    document.documentElement.setAttribute("data-theme", "dark");
  });
  const darkViolations = await page.evaluate(async () => {
    const result = await window.axe.run(document, {
      runOnly: { type: "tag", values: ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"] },
      resultTypes: ["violations"],
    });
    return result.violations.map((v) => ({ id: v.id, help: v.help, targets: v.nodes.map((n) => n.target.join(" ")) }));
  });
  for (const v of darkViolations) {
    const more = v.targets.length > 3 ? ` (+${v.targets.length - 3} more)` : "";
    problems.push(`(dark): ${v.id}: ${v.help} [${v.targets.slice(0, 3).join(", ")}${more}]`);
  }

  // 3. Layout at phone width (restoring light mode)
  await page.evaluate(() => {
    document.documentElement.removeAttribute("data-theme");
    const style = document.getElementById("disable-transitions");
    if (style) style.remove();
  });
  await page.setViewport(PHONE_VIEWPORT);
  const wide = await page.evaluate((targetWidth) => {
    const width = Math.min(window.innerWidth, targetWidth);
    if (document.documentElement.scrollWidth <= width + 1) return null;
    const culprits = [...document.querySelectorAll("body *")].filter((el) => {
      if (el.getBoundingClientRect().right <= width + 1) return false;
      return ![...el.children].some((child) => child.getBoundingClientRect().right > width + 1);
    });
    return culprits.slice(0, 3).map((el) => el.outerHTML.slice(0, 100));
  }, PHONE_VIEWPORT.width);
  if (wide) problems.push(`(phone): scrolls sideways at ${PHONE_VIEWPORT.width}px: ${wide.join(" | ")}`);

  await page.close();
  return problems;
}

async function main() {
  const pages = listPages(SITE).sort();
  const server = await serve();
  const origin = `http://127.0.0.1:${server.address().port}`;
  const browser = await puppeteer.launch({ executablePath: CHROME, args: ["--no-sandbox"] });

  const failures = [];

  // Verify that a stored dark-theme preference initializes dark mode on page load.
  const initContext = await browser.createBrowserContext();
  try {
    const initPage = await initContext.newPage();
    await initPage.evaluateOnNewDocument(() => {
      try {
        localStorage.setItem("paara-theme", "dark");
      } catch (e) {}
    });
    await initPage.goto(origin + "/index.html", { waitUntil: "domcontentloaded" });
    const isDark = await initPage.evaluate(() => document.documentElement.getAttribute("data-theme") === "dark");
    if (!isDark) failures.push("Dark mode failed to initialize from localStorage on page load.");
    await initPage.close();
  } catch (err) {
    failures.push(`Could not check dark mode initialization: ${err.message}`);
  } finally {
    await initContext.close();
  }

  // One context per worker so concurrent workers don't share cookies or storage.
  const contexts = await Promise.all(Array.from({ length: WORKERS }, () => browser.createBrowserContext()));
  let next = 0;
  async function worker(context) {
    while (next < pages.length) {
      const url = pages[next++];
      // Retry once if Chrome itself fails (e.g. a lost tab); page problems
      // are reported on the first try.
      for (let attempt = 1; attempt <= 2; attempt++) {
        try {
          for (const problem of await checkPage(context, origin, url)) {
            const prefix = problem.startsWith("(") ? `${url} ` : `${url}: `;
            failures.push(`${prefix}${problem}`);
          }
          break;
        } catch (err) {
          if (attempt === 2) failures.push(`${url}: could not check page: ${err.message}`);
        }
      }
    }
  }
  await Promise.all(contexts.map((context) => worker(context)));
  await browser.close();
  server.close();

  failures.sort();
  for (const failure of failures) console.log(failure);
  console.log(`${failures.length} problem(s) on ${pages.length} pages (light, dark, phone).`);
  if (failures.length && REPORT_ONLY) console.log("Report-only mode: not failing the build.");
  process.exitCode = failures.length && !REPORT_ONLY ? 1 : 0;
}

main().catch((err) => {
  console.error(err);
  process.exitCode = 1;
});
