#!/bin/sh

# Checks external links in the built site (_site). Run by the weekly
# external-links workflow; not part of the deploy path, because outside
# sites going down must not block publishing.

set -e

bundle exec htmlproofer --url-ignore "/snars.org\/repeaters\/info/,/powerequipment\.honda\.com/,/ncpa\.n0ary\.org/,/www\.hti\.umich\.edu/,/www\.sk3bg\.se/,/ww1x\.radio/,/fcc\.gov/,/arrl\.org/,/cactus-intertie\.org/,/nps\.gov/,/svve\.org/,/aprs\.net/,/adventureradio\.info/,/papasys\.com/,/www\.sotadata\.org\.uk/,/efficacy\.net/,/paypal\.com/,/cal-net\.org/,/mountainview\.gov/,/amsat\.org/,/winaprs\.org/,/liquid-robotics\.com/,/ui-view\.org/,/contesting\.com/" ./_site --http-status-ignore "403" --typhoeus '{"connecttimeout":30,"timeout":60}'
