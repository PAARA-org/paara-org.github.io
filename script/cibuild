#!/bin/sh

set -e

bundle exec jekyll build
# Internal links and HTML only; external links are checked weekly by
# script/check-external-links. PayPal's SDK is dynamic and cannot carry SRI.
bundle exec htmlproofer ./_site --disable-external --check-html --check-sri --url-ignore "/paypal\.com/"
bundle exec rubocop -D --config .rubocop.yml
bundle exec script/validate-html
gem build jekyll-theme-architect.gemspec
